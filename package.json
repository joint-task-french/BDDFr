{
  "name": "jtfr-bddfr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "prebuild": "npm run prepare && npm run sync-data",
    "predev": "npm run prepare && npm run sync-data",
    "sync-data": "node scripts/sync-data.mjs",
    "generate-statics": "node scripts/generate-static-pages.mjs",
    "generate-statics-images": "node scripts/generate-static-pages-images.mjs",
    "validate-ensembles-pieces": "node scripts/validate/validate-ensembles-pieces.mjs",
    "validate-schemas": "node scripts/validate/validate-schemas.mjs",
    "validate-slugs": "node scripts/validate/validate-slugs.mjs",
    "validate-icons": "node scripts/validate/validate-icons.mjs",
    "validate-skill-mods": "node scripts/validate/validate-skill-mods.mjs",
    "validate": "npm run validate-schemas && npm run validate-slugs && npm run validate-ensembles-pieces && npm run validate-skill-mods && npm run test",
    "validate-all": "node scripts/validate/validate.mjs && npm run lint:ci && npm run test",
    "dev": "vite",
    "build": "vite build && npm run generate-statics",
    "buildWithImages": "vite build && npm run generate-statics-images",
    "preview": "npm run build && vite preview",
    "previewUnbuild": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:build": "npm run build && npm run smoke",
    "generate-types": "node scripts/generate-types.mjs",
    "lint:ci": "eslint . --max-warnings 134"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "lz-string": "^1.5.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "$vite"
    }
  }
}
